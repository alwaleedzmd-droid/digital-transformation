# انسخ هذا الملف إلى .streamlit/secrets.toml وعبئ القيم الحقيقية
# في النشر على Streamlit Cloud ضع نفس المحتوى في: Settings → Secrets

[supabase]
url = "https://YOUR-PROJECT-REF.supabase.co"
# anon key — للقراءة العامة محظورة لكن INSERT مسموح (تُستخدم في نموذج الاستبيان)
anon_key = "eyJ..."
# service role key — تجاوز RLS، تُستخدم في لوحة التحكم فقط (لا تكشفها أبداً)
service_role_key = "eyJ..."

[dashboard.users]
# بيانات الدخول للوحة التحكم - يمكن إضافة عدة مستخدمين
# الصيغة: "اسم_المستخدم" = "كلمة_السر"
"admin" = "ChangeMe-Strong-Password-123!"
# "another_user" = "Another-Strong-Pass-456!"

[anthropic]
# اختياري - لو تركته فاضي يتم إخفاء قسم تقييم الذكاء الاصطناعي
api_key = ""
model = "claude-sonnet-4-6"
